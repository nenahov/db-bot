BOT_TOKEN=123456:replace-me
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
SQLITE_PATH=./data/bot.db
QUERY_PREVIEW_ROWS=50
QUERY_MAX_ROWS=50000
QUERY_TIMEOUT_SEC=60
RESULT_CACHE_TTL_SEC=3600
LOG_DIR=./logs
# Comma-separated group/channel ids. Empty = access check disabled.
AUTH_GROUP_IDS=
# How many first groups to show as Subscribe buttons
AUTH_SUBSCRIBE_COUNT=1
# Successful membership check cache, seconds (10 hours)
AUTH_CACHE_TTL_SEC=36000
